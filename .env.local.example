# Project URL SIN sufijo de ruta (nada de /rest/v1/ al final) — Supabase Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# anon / public key (o "sb_publishable_..." en proyectos con las claves nuevas) — misma pantalla
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service Role Key (Settings -> API Keys -> "service_role"): SECRETA, se salta RLS.
# Solo se usa server-side (importación de horarios desde Excel). NUNCA debe llevar
# el prefijo NEXT_PUBLIC_ ni exponerse al navegador — no la compartas en el chat.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
